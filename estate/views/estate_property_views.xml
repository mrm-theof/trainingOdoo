<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Action pour ouvrir la vue des propriétés -->
    <record id="action_estate_property" model="ir.actions.act_window">
        <field name="name">Properties</field>
        <field name="res_model">estate.property</field>
        <!-- On définit l'ordre d'ouverture des vues : tree, form, kanban, graph -->
        <field name="view_mode">tree,form,kanban,graph</field>
    </record>

    <!-- Menu principal "Real Estate" -->
    <menuitem id="menu_estate_root" name="Real Estate"/>

    <!-- Sous-menu "Properties" pointant sur l'action -->
    <menuitem id="menu_estate_property"
              name="Properties"
              parent="menu_estate_root"
              action="action_estate_property"/>

    <!-- Vue Kanban -->
    <record id="view_estate_property_kanban" model="ir.ui.view">
        <field name="name">estate.property.kanban</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <kanban>
                <!--
                  On n'utilise plus 'attrs' ici et on n'affiche pas de bouton.
                  On se contente des badges pour représenter l'état.
                -->
                <templates>
                    <t t-name="kanban-box">
                        <div class="o_kanban_record">
                            <strong>
                                <t t-esc="record.name.value" />
                            </strong>
                            <div>
                                <span class="badge bg-success"
                                      t-if="record.state.value == 'sold'">Sold
                                </span>
                                <span class="badge bg-danger"
                                      t-if="record.state.value == 'canceled'">Canceled
                                </span>
                                <span class="badge bg-warning"
                                      t-if="record.state.value == 'new'">New
                                </span>
                                <span class="badge bg-info"
                                      t-if="record.state.value == 'offer_received'">
                                    Offer Received
                                </span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Vue Liste (Tree) -->
    <record id="view_estate_property_tree" model="ir.ui.view">
        <field name="name">estate.property.tree</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="expected_price"/>
                <field name="selling_price"/>
                <field name="state"/>
                <field name="garden"/>
                <field name="property_type_id"/>
            </tree>
        </field>
    </record>

    <!-- Vue Formulaire -->
    <record id="view_estate_property_form" model="ir.ui.view">
        <field name="name">estate.property.form</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <form>
                <!-- On place les boutons dans le header -->
                <header>
                    <!-- Bouton "Mark as Sold" -->
                    <button name="action_sell_property"
                            type="object"
                            string="Mark as Sold"
                            class="btn-primary"
                            attrs="{'invisible': [('state', 'in', ['sold','canceled'])]}" />

                    <!-- Bouton "Cancel" -->
                    <button name="action_cancel_property"
                            type="object"
                            string="Cancel"
                            class="btn-secondary"
                            attrs="{'invisible': [('state', 'in', ['sold','canceled'])]}" />
                </header>

                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="description"/>
                        <field name="postcode"/>
                        <field name="date_availability"/>
                        <field name="expected_price" required="1"/>
                        <field name="selling_price" readonly="0"/>
                        <field name="property_type_id"/>
                        <field name="state" readonly="1"/>
                    </group>
                    <group>
                        <field name="bedrooms"/>
                        <field name="living_area"/>
                        <field name="facades"/>
                        <field name="garage"/>
                        <field name="garden"/>
                        <field name="garden_area"/>
                        <field name="garden_orientation"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vue Graphique -->
    <record id="view_estate_property_graph" model="ir.ui.view">
        <field name="name">estate.property.graph</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <graph type="bar">
                <field name="expected_price" type="measure"/>
                <field name="selling_price" type="measure"/>
                <field name="name" type="category"/>
            </graph>
        </field>
    </record>

    <!-- Vue Recherche -->
    <record id="view_estate_property_search" model="ir.ui.view">
        <field name="name">estate.property.search</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="expected_price"/>
                <field name="selling_price"/>
                <field name="property_type_id"/>
                <field name="state"/>
                <filter name="not_sold" string="Not Sold" domain="[('state', '!=', 'sold')]"/>
                <filter name="sold" string="Sold" domain="[('state', '=', 'sold')]"/>
                <filter name="new" string="New" domain="[('state', '=', 'new')]"/>
                <filter name="canceled" string="Canceled" domain="[('state', '=', 'canceled')]"/>
            </search>
        </field>
    </record>
</odoo>
